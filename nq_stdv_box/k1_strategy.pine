//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// NQ Stdv Box – Strategie K1            (nur auf dem 1-MINUTEN-Chart verwenden, NQ / MNQ)
//
// Box   : Open der 00:00-ET-Kerze bis Open der 08:30-ET-Kerze, Mitte = 50 %, h = halbe Boxhöhe
// Level : Mitte ± k·h  (k = 2, 2.25, 2.5, 3.5, 4, 4.25, 4.5)
//
// K1-Regeln (identisch zum Python-Backtest):
//   1. Limit-Order direkt an einem Stdv-Level (unter der Box = Long, über der Box = Short).
//   2. Nur Touches zwischen 11:00 und 13:30 ET.
//   3. Das Level liegt in einer noch gültigen ICT-Zone passender Richtung (bullische Zone für Long,
//      bärische für Short; Toleranz ± 2,5 Punkte). Zonen auf 5-Minuten-Kerzen:
//        FVG  : Low[i] > High[i−2] (bullisch) bzw. High[i] < Low[i−2] (bärisch)
//        OB   : letzte Gegenkerze vor einer Displacement-Kerze, die darüber/darunter schließt und ein FVG erzeugt
//        RB   : Swing-Hoch/-Tief (2 Kerzen je Seite) mit Docht ≥ 50 % der Kerzenrange, Zone = Docht
//      Eine Zone gilt bis zum ersten 5-Min-Schluss jenseits der Zone, höchstens 48 Stunden.
//   4. Pro Level und Tag max. N Touches; ein Level wird erst wieder "scharf", wenn eine Kerze
//      mind. 0,02·ATR auf der Ausgangsseite schließt.
//   5. Stop: 0,06·ATR hinter dem Level. Ziel: Box-Mitte. 15:59 ET flat. Nur eine Position gleichzeitig.
//   ATR = Durchschnitt der Tagesrange (High−Low) der letzten 14 abgeschlossenen Handelstage.
//   Limit-Orders gelten erst als gefüllt, wenn der Preis 1 Tick durch das Level handelt.
// ─────────────────────────────────────────────────────────────────────────────────────────────
strategy("NQ Stdv Box – K1", overlay = true, process_orders_on_close = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     backtest_fill_limits_assumption = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.6, slippage = 1,
     max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// ───────────── Inputs
grpT = "Zeiten"
tz   = input.string("America/New_York", "Zeitzone", group = grpT)
sH   = input.int(0,  "Box-Start (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "s")
sM   = input.int(0,  "",           minval = 0, maxval = 59, group = grpT, inline = "s")
eH   = input.int(8,  "Box-Ende (Std : Min)",  minval = 0, maxval = 23, group = grpT, inline = "e")
eM   = input.int(30, "",           minval = 0, maxval = 59, group = grpT, inline = "e")
xH   = input.int(16, "Handelsende (Std)", minval = 0, maxval = 23, group = grpT)
wH1  = input.int(11, "Entry-Fenster von (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "w1")
wM1  = input.int(0,  "", minval = 0, maxval = 59, group = grpT, inline = "w1")
wH2  = input.int(13, "Entry-Fenster bis (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "w2")
wM2  = input.int(30, "", minval = 0, maxval = 59, group = grpT, inline = "w2")

grpK = "K1-Regeln"
maxTouches = input.int(3, "Max. Touches pro Level und Tag", minval = 1, maxval = 10, group = grpK)
needIct    = input.bool(true, "ICT-Zone nötig (FVG / OB / RB)", group = grpK)
zoneTol    = input.float(2.5, "Zonen-Toleranz (Punkte)", minval = 0, group = grpK)
stopAtr    = input.float(0.06, "Stop (× ATR) hinter dem Level", minval = 0.005, step = 0.005, group = grpK)
rearmAtr   = input.float(0.02, "Re-Arm-Abstand (× ATR)", minval = 0, step = 0.005, group = grpK)

grpR = "Positionsgröße"
riskUsd = input.float(150, "Risiko pro Trade ($)", minval = 1, group = grpR)
maxQty  = input.int(50, "Max. Kontrakte", minval = 1, group = grpR)

grpV = "Darstellung"
boxCol = input.color(color.new(color.blue, 80), "Box", group = grpV)
midCol = input.color(color.white, "Mittellinie", group = grpV)
lvlCol = input.color(color.new(color.gray, 40), "Level", group = grpV)

// ───────────── ATR14 der letzten 14 abgeschlossenen Handelstage (kein Repainting)
atrD = request.security(syminfo.tickerid, "D", ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_on)

// ───────────── ICT-Zonen auf selbst gebauten 5-Minuten-Kerzen
var array<float> zLo  = array.new<float>()
var array<float> zHi  = array.new<float>()
var array<int>   zPol = array.new<int>()      // +1 bullisch, −1 bärisch
var array<int>   zAv  = array.new<int>()      // Zeitpunkt, ab dem die Zone gilt (ms)
var array<float> bO = array.new<float>()
var array<float> bH = array.new<float>()
var array<float> bL = array.new<float>()
var array<float> bC = array.new<float>()
var array<int>   bT = array.new<int>()
var int   bkt  = na
var float o5   = na
var float h5   = na
var float l5   = na
var float c5   = na
var bool  fin5 = true

MS5  = 300000
MS48 = 48 * 60 * 60 * 1000

addZone(float lo, float hi, int pol, int av) =>
    zLo.push(lo)
    zHi.push(hi)
    zPol.push(pol)
    zAv.push(av)

finalize5(float o, float h, float l, float c, int tOpen) =>
    tClose = tOpen + MS5
    // 1) bestehende Zonen invalidieren (Schluss jenseits der Zone oder älter als 48 h)
    if zLo.size() > 0
        for j = zLo.size() - 1 to 0
            dead = (zPol.get(j) == -1 and c > zHi.get(j)) or (zPol.get(j) == 1 and c < zLo.get(j)) or (tClose - zAv.get(j) >= MS48)
            if dead
                zLo.remove(j)
                zHi.remove(j)
                zPol.remove(j)
                zAv.remove(j)
    // 2) Kerze speichern (letzte 5)
    bO.push(o)
    bH.push(h)
    bL.push(l)
    bC.push(c)
    bT.push(tOpen)
    if bO.size() > 5
        bO.shift()
        bH.shift()
        bL.shift()
        bC.shift()
        bT.shift()
    n = bO.size()
    // 3) FVG + Order Block (Kerzen i−2, i−1, i)
    if n >= 3
        i = n - 1
        k = i - 2
        if bT.get(i) - bT.get(k) <= 15 * 60000
            if bL.get(i) > bH.get(k)
                addZone(bH.get(k), bL.get(i), 1, tClose)
            if bH.get(i) < bL.get(k)
                addZone(bH.get(i), bL.get(k), -1, tClose)
            if bC.get(k) < bO.get(k) and bC.get(k + 1) > bO.get(k + 1) and bC.get(k + 1) > bH.get(k) and bL.get(i) > bH.get(k)
                addZone(bL.get(k), bH.get(k), 1, tClose)
            if bC.get(k) > bO.get(k) and bC.get(k + 1) < bO.get(k + 1) and bC.get(k + 1) < bL.get(k) and bH.get(i) < bL.get(k)
                addZone(bL.get(k), bH.get(k), -1, tClose)
    // 4) Rejection Block (Swing in der Mitte von 5 Kerzen)
    if n >= 5
        m = n - 3
        if bT.get(n - 1) - bT.get(n - 5) <= 25 * 60000
            rng = bH.get(m) - bL.get(m)
            if rng > 0
                bodyHi = math.max(bO.get(m), bC.get(m))
                bodyLo = math.min(bO.get(m), bC.get(m))
                if bH.get(m) > math.max(bH.get(m - 1), bH.get(m - 2), bH.get(m + 1), bH.get(m + 2)) and bH.get(m) - bodyHi >= 0.5 * rng
                    addZone(bodyHi, bH.get(m), -1, tClose)
                if bL.get(m) < math.min(bL.get(m - 1), bL.get(m - 2), bL.get(m + 1), bL.get(m + 2)) and bodyLo - bL.get(m) >= 0.5 * rng
                    addZone(bL.get(m), bodyLo, 1, tClose)
    true

int bucketStart = time - time % MS5            // Öffnungszeit der laufenden 5-Minuten-Kerze (ms)
if na(bkt) or bucketStart != bkt
    if not na(bkt) and not fin5
        finalize5(o5, h5, l5, c5, bkt)
    bkt  := bucketStart
    o5   := open
    h5   := high
    l5   := low
    c5   := close
    fin5 := false
else
    h5 := math.max(h5, high)
    l5 := math.min(l5, low)
    c5 := close
if not fin5 and time_close >= bkt + MS5
    finalize5(o5, h5, l5, c5, bkt)
    fin5 := true

inZone(float p, int sd) =>
    bool res = false
    if zLo.size() > 0
        for j = 0 to zLo.size() - 1
            if zPol.get(j) == sd and zLo.get(j) - zoneTol <= p and zHi.get(j) + zoneTol >= p
                res := true
                break
    res

// ───────────── Zeiten
y  = year(time, tz)
mo = month(time, tz)
d  = dayofmonth(time, tz)
tS = timestamp(tz, y, mo, d, sH, sM)
tE = timestamp(tz, y, mo, d, eH, eM)
tX = timestamp(tz, y, mo, d, xH, 0)
tW1 = timestamp(tz, y, mo, d, wH1, wM1)
tW2 = timestamp(tz, y, mo, d, wH2, wM2)
isStart = time >= tS and (na(time[1]) or time[1] < tS)
isEnd   = time >= tE and (na(time[1]) or time[1] < tE)

// ───────────── State
var float o0     = na
var int   t0     = na
var int   tStop  = na
var bool  active = false
var float mid    = na
var float atrDay = na
var array<float> mults = array.from(2.0, 2.25, 2.5, 3.5, 4.0, 4.25, 4.5)
var array<float> lvP   = array.new<float>()   // Level-Preis
var array<int>   lvS   = array.new<int>()     // +1 = Long (Level unter der Mitte), −1 = Short
var array<bool>  lvArm = array.new<bool>()
var array<int>   lvN   = array.new<int>()     // Touches heute

if isStart
    o0     := open
    t0     := time
    active := false

if isEnd and not na(o0) and not na(atrD)
    o830 = open
    top  = math.max(o0, o830)
    bot  = math.min(o0, o830)
    h    = (top - bot) / 2
    mid    := (top + bot) / 2
    atrDay := atrD
    tStop  := tX
    lvP.clear()
    lvS.clear()
    lvArm.clear()
    lvN.clear()
    box.new(t0, top, tX, bot, xloc = xloc.bar_time, bgcolor = boxCol, border_color = color.new(color.blue, 40))
    line.new(t0, mid, tX, mid, xloc = xloc.bar_time, color = midCol)
    for k in mults
        for sg in array.from(1, -1)
            p  = mid + sg * k * h
            sd = -sg                                   // Level über der Mitte = Short, darunter = Long
            lvP.push(p)
            lvS.push(sd)
            lvArm.push((open - p) * sd >= rearmAtr * atrDay)
            lvN.push(0)
            line.new(time, p, tX, p, xloc = xloc.bar_time, color = lvlCol)
            label.new(tX, p, (sg == 1 ? "+" : "-") + str.tostring(k), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = lvlCol, size = size.tiny)
    active := h > 0
    o0     := na

bool isLastBar = active and not na(tStop) and time_close >= tStop
riskPts     = stopAtr * nz(atrDay)

// ───────────── Touch-Zähler aktualisieren, dann Limit-Orders für die NÄCHSTE Kerze setzen
if active and time < tStop and lvP.size() > 0
    rearm = rearmAtr * atrDay
    for i = 0 to lvP.size() - 1
        p  = lvP.get(i)
        sd = lvS.get(i)
        if lvArm.get(i) and lvN.get(i) < maxTouches
            touched = sd == 1 ? low <= p - syminfo.mintick : high >= p + syminfo.mintick
            if touched
                lvN.set(i, lvN.get(i) + 1)
                lvArm.set(i, false)
        if not lvArm.get(i) and (close - p) * sd >= rearm
            lvArm.set(i, true)

    flat     = strategy.position_size == 0
    inWindow = time_close >= tW1 and time_close < tW2 and time_close < tStop
    if flat
        strategy.cancel_all()
    for i = 0 to lvP.size() - 1
        p  = lvP.get(i)
        sd = lvS.get(i)
        id = (sd == 1 ? "K1 Long " : "K1 Short ") + str.tostring(i)
        ok = flat and inWindow and not isLastBar and lvArm.get(i) and lvN.get(i) < maxTouches and (mid - p) * sd > 0 and riskPts > 0 and (not needIct or inZone(p, sd))
        if ok
            lim  = math.round_to_mintick(p)
            stop = math.round_to_mintick(p - sd * riskPts)
            qty  = math.max(1, math.min(maxQty, math.floor(riskUsd / (riskPts * syminfo.pointvalue))))
            strategy.entry(id, sd == 1 ? strategy.long : strategy.short, qty = qty, limit = lim)
            strategy.exit("Exit " + id, id, stop = stop, limit = math.round_to_mintick(mid))
        else
            strategy.cancel(id)

// ───────────── Tagesende
if isLastBar
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment = "15:59")
    active := false

plot(strategy.position_size != 0 ? strategy.position_avg_price - math.sign(strategy.position_size) * riskPts : na, "Stop", color.red, 1, plot.style_linebr)
plot(strategy.position_size != 0 ? mid : na, "Ziel", color.green, 1, plot.style_linebr)

if barstate.islast and not (timeframe.isminutes and timeframe.multiplier == 1)
    label.new(bar_index, high, "K1 ist für den 1-Minuten-Chart gebaut.\nBitte Timeframe auf 1m stellen.", color = color.orange, textcolor = color.black)
