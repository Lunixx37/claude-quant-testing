//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// NQ Stdv Box – K1 / K2 (umschaltbar)        nur auf dem 1-MINUTEN-Chart verwenden (NQ / MNQ)
//
// Einstellung "Strategie":  K1  |  K2  |  K1 + K2 (max. eine Position gleichzeitig)
//
// Box   : Open der 00:00-ET-Kerze bis Open der 08:30-ET-Kerze, Mitte = 50 %, h = halbe Boxhöhe
// Level : Mitte ± k·h  (k = 2, 2.25, 2.5, 3.5, 4, 4.25, 4.5) + beide Box-Kanten
// ATR   : Durchschnitt der Tagesrange (High−Low) der letzten 14 abgeschlossenen Handelstage
//
// K1 – Limit an einem Stdv-Level (unter der Box Long, über der Box Short), nur Touches 11:00–13:30 ET,
//      Level liegt in einer gültigen ICT-Zone passender Richtung (FVG / OB / RB auf 5-Min-Kerzen, gültig bis
//      zum ersten 5-Min-Schluss jenseits der Zone, max. 48 h). Stop 0,06·ATR hinter dem Level, Ziel Box-Mitte.
// K2 – Reclaim am 3.5-Level: Preis handelt mind. 1 Tick durch das Level, innerhalb von 10 Kerzen schließt
//      eine 1-Min-Kerze zurück (über dem Hoch / unter dem Tief der Vorkerze und in Trade-Richtung); vor dem
//      Touch gab es heute schon einen Reclaim in die Gegenrichtung an irgendeinem Level. Entry = Schluss dieser
//      Kerze, Stop hinter dem Sweep-Extrem (mind. 0,02·ATR), Ziel Box-Mitte.
// Beide: max. N Touches pro Level und Tag (Level wird erst wieder scharf, wenn eine Kerze mind. 0,02·ATR
//      auf der Ausgangsseite schließt), 15:59 ET flat.
// ─────────────────────────────────────────────────────────────────────────────────────────────
strategy("NQ Stdv Box – K1 / K2", overlay = true, process_orders_on_close = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     backtest_fill_limits_assumption = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.6, slippage = 1,
     max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// ───────────── Inputs
mode  = input.string("K2", "Strategie", options = ["K1", "K2", "K1 + K2"])
runK1 = mode != "K2"
runK2 = mode != "K1"

grpT = "Zeiten"
tz   = input.string("America/New_York", "Zeitzone", group = grpT)
sH   = input.int(0,  "Box-Start (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "s")
sM   = input.int(0,  "",           minval = 0, maxval = 59, group = grpT, inline = "s")
eH   = input.int(8,  "Box-Ende (Std : Min)",  minval = 0, maxval = 23, group = grpT, inline = "e")
eM   = input.int(30, "",           minval = 0, maxval = 59, group = grpT, inline = "e")
xH   = input.int(16, "Handelsende (Std)", minval = 0, maxval = 23, group = grpT)
rearmAtr = input.float(0.02, "Re-Arm-Abstand (× ATR)", minval = 0, step = 0.005, group = grpT)

grp1 = "K1"
wH1  = input.int(11, "Entry-Fenster von (Std : Min)", minval = 0, maxval = 23, group = grp1, inline = "w1")
wM1  = input.int(0,  "", minval = 0, maxval = 59, group = grp1, inline = "w1")
wH2  = input.int(13, "Entry-Fenster bis (Std : Min)", minval = 0, maxval = 23, group = grp1, inline = "w2")
wM2  = input.int(30, "", minval = 0, maxval = 59, group = grp1, inline = "w2")
k1Touches = input.int(3, "Max. Touches pro Level und Tag", minval = 1, maxval = 10, group = grp1)
needIct   = input.bool(true, "ICT-Zone nötig (FVG / OB / RB)", group = grp1)
zoneTol   = input.float(2.5, "Zonen-Toleranz (Punkte)", minval = 0, group = grp1)
k1StopAtr = input.float(0.06, "Stop (× ATR) hinter dem Level", minval = 0.005, step = 0.005, group = grp1)
k1Risk    = input.float(150, "Risiko pro Trade ($)", minval = 1, group = grp1)

grp2 = "K2"
k2Level     = input.float(3.5, "Setup-Level (Stdv)", group = grp2)
k2Touches   = input.int(3, "Max. Touches pro Level und Tag (Basis 3, gelockert 6)", minval = 1, maxval = 10, group = grp2)
reclaimBars = input.int(10, "Reclaim-Fenster in Kerzen", minval = 0, maxval = 60, group = grp2)
needPrior   = input.bool(true, "Vorherige Gegenreaktion nötig", group = grp2)
needMom     = input.bool(true, "Momentum-Kerze nötig", group = grp2)
minStopAtr  = input.float(0.02, "Mindest-Stop (× ATR)", minval = 0, step = 0.005, group = grp2)
k2Risk      = input.float(200, "Risiko pro Trade ($)", minval = 1, group = grp2)

grpV = "Darstellung"
maxQty = input.int(50, "Max. Kontrakte", minval = 1, group = grpV)
boxCol = input.color(color.new(color.blue, 80), "Box", group = grpV)
midCol = input.color(color.white, "Mittellinie", group = grpV)
lvlCol = input.color(color.new(color.gray, 40), "Level", group = grpV)
k2Col  = input.color(color.new(color.red, 0), "K2-Setup-Level", group = grpV)

// ───────────── ATR14 der letzten 14 abgeschlossenen Handelstage (kein Repainting)
atrD = request.security(syminfo.tickerid, "D", ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_on)

// ═════════════ ICT-Zonen auf selbst gebauten 5-Minuten-Kerzen (für K1)
var array<float> zLo  = array.new<float>()
var array<float> zHi  = array.new<float>()
var array<int>   zPol = array.new<int>()      // +1 bullisch, −1 bärisch
var array<int>   zAv  = array.new<int>()
var array<float> bO = array.new<float>()
var array<float> bH = array.new<float>()
var array<float> bL = array.new<float>()
var array<float> bC = array.new<float>()
var array<int>   bT = array.new<int>()
var int   bkt  = na
var float o5   = na
var float h5   = na
var float l5   = na
var float c5   = na
var bool  fin5 = true

MS5  = 300000
MS48 = 48 * 60 * 60 * 1000

addZone(float lo, float hi, int pol, int av) =>
    zLo.push(lo)
    zHi.push(hi)
    zPol.push(pol)
    zAv.push(av)

finalize5(float o, float h, float l, float c, int tOpen) =>
    tClose = tOpen + MS5
    if zLo.size() > 0
        for j = zLo.size() - 1 to 0
            dead = (zPol.get(j) == -1 and c > zHi.get(j)) or (zPol.get(j) == 1 and c < zLo.get(j)) or (tClose - zAv.get(j) >= MS48)
            if dead
                zLo.remove(j)
                zHi.remove(j)
                zPol.remove(j)
                zAv.remove(j)
    bO.push(o)
    bH.push(h)
    bL.push(l)
    bC.push(c)
    bT.push(tOpen)
    if bO.size() > 5
        bO.shift()
        bH.shift()
        bL.shift()
        bC.shift()
        bT.shift()
    n = bO.size()
    if n >= 3
        i = n - 1
        k = i - 2
        if bT.get(i) - bT.get(k) <= 15 * 60000
            if bL.get(i) > bH.get(k)
                addZone(bH.get(k), bL.get(i), 1, tClose)
            if bH.get(i) < bL.get(k)
                addZone(bH.get(i), bL.get(k), -1, tClose)
            if bC.get(k) < bO.get(k) and bC.get(k + 1) > bO.get(k + 1) and bC.get(k + 1) > bH.get(k) and bL.get(i) > bH.get(k)
                addZone(bL.get(k), bH.get(k), 1, tClose)
            if bC.get(k) > bO.get(k) and bC.get(k + 1) < bO.get(k + 1) and bC.get(k + 1) < bL.get(k) and bH.get(i) < bL.get(k)
                addZone(bL.get(k), bH.get(k), -1, tClose)
    if n >= 5
        m = n - 3
        if bT.get(n - 1) - bT.get(n - 5) <= 25 * 60000
            rng = bH.get(m) - bL.get(m)
            if rng > 0
                bodyHi = math.max(bO.get(m), bC.get(m))
                bodyLo = math.min(bO.get(m), bC.get(m))
                if bH.get(m) > math.max(bH.get(m - 1), bH.get(m - 2), bH.get(m + 1), bH.get(m + 2)) and bH.get(m) - bodyHi >= 0.5 * rng
                    addZone(bodyHi, bH.get(m), -1, tClose)
                if bL.get(m) < math.min(bL.get(m - 1), bL.get(m - 2), bL.get(m + 1), bL.get(m + 2)) and bodyLo - bL.get(m) >= 0.5 * rng
                    addZone(bL.get(m), bodyLo, 1, tClose)
    true

int bucketStart = time - time % MS5            // Öffnungszeit der laufenden 5-Minuten-Kerze (ms)
if na(bkt) or bucketStart != bkt
    if not na(bkt) and not fin5
        finalize5(o5, h5, l5, c5, bkt)
    bkt  := bucketStart
    o5   := open
    h5   := high
    l5   := low
    c5   := close
    fin5 := false
else
    h5 := math.max(h5, high)
    l5 := math.min(l5, low)
    c5 := close
if not fin5 and time_close >= bkt + MS5
    finalize5(o5, h5, l5, c5, bkt)
    fin5 := true

inZone(float p, int sd) =>
    bool res = false
    if zLo.size() > 0
        for j = 0 to zLo.size() - 1
            if zPol.get(j) == sd and zLo.get(j) - zoneTol <= p and zHi.get(j) + zoneTol >= p
                res := true
                break
    res

// ═════════════ Zeiten
y  = year(time, tz)
mo = month(time, tz)
d  = dayofmonth(time, tz)
tS  = timestamp(tz, y, mo, d, sH, sM)
tE  = timestamp(tz, y, mo, d, eH, eM)
tX  = timestamp(tz, y, mo, d, xH, 0)
tW1 = timestamp(tz, y, mo, d, wH1, wM1)
tW2 = timestamp(tz, y, mo, d, wH2, wM2)
isStart = time >= tS and (na(time[1]) or time[1] < tS)
isEnd   = time >= tE and (na(time[1]) or time[1] < tE)

// ═════════════ State
var float o0       = na
var int   t0       = na
var int   tStop    = na
var bool  active   = false
var float mid      = na
var float atrDay   = na
var int   sessBar0 = na
var float curStop  = na
var float curTgt   = na
var array<float> mults = array.from(2.0, 2.25, 2.5, 3.5, 4.0, 4.25, 4.5)

// K1: Stdv-Level auf ihrer natürlichen Seite
var array<float> aP   = array.new<float>()
var array<int>   aS   = array.new<int>()     // +1 = Long (Level unter der Mitte), −1 = Short
var array<bool>  aArm = array.new<bool>()
var array<int>   aN   = array.new<int>()

// K2: alle Level (inkl. Box-Kanten), jeweils als Support und als Resistance
var array<float> lvP    = array.new<float>()
var array<int>   lvS    = array.new<int>()   // +1 = Support (Long), −1 = Resistance (Short)
var array<bool>  lvK2   = array.new<bool>()
var array<bool>  lvArm  = array.new<bool>()
var array<int>   lvPend = array.new<int>()   // Touch-Bar eines offenen Reclaim-Fensters, −1 = keins
var array<float> lvExt  = array.new<float>()
var array<int>   lvN    = array.new<int>()
var int firstBull = na                       // frühester bullischer Reclaim des Tages (bar_index)
var int firstBear = na

addLevel2(float p, bool isK2, float rearm) =>
    for sd in array.from(1, -1)
        lvP.push(p)
        lvS.push(sd)
        lvK2.push(isK2)
        lvArm.push((open - p) * sd >= rearm)
        lvPend.push(-1)
        lvExt.push(na)
        lvN.push(0)

if isStart
    o0     := open
    t0     := time
    active := false

if isEnd and not na(o0) and not na(atrD)
    o830 = open
    top  = math.max(o0, o830)
    bot  = math.min(o0, o830)
    h    = (top - bot) / 2
    mid      := (top + bot) / 2
    atrDay   := atrD
    tStop    := tX
    sessBar0 := bar_index
    firstBull := na
    firstBear := na
    aP.clear()
    aS.clear()
    aArm.clear()
    aN.clear()
    lvP.clear()
    lvS.clear()
    lvK2.clear()
    lvArm.clear()
    lvPend.clear()
    lvExt.clear()
    lvN.clear()
    rearm = rearmAtr * atrDay
    box.new(t0, top, tX, bot, xloc = xloc.bar_time, bgcolor = boxCol, border_color = color.new(color.blue, 40))
    line.new(t0, mid, tX, mid, xloc = xloc.bar_time, color = midCol)
    addLevel2(o0, false, rearm)
    addLevel2(o830, false, rearm)
    for k in mults
        isK2 = math.abs(k - k2Level) < 0.0001
        hl   = isK2 and runK2
        for sg in array.from(1, -1)
            p = mid + sg * k * h
            addLevel2(p, isK2, rearm)
            aP.push(p)
            aS.push(-sg)
            aArm.push((open - p) * -sg >= rearm)
            aN.push(0)
            line.new(time, p, tX, p, xloc = xloc.bar_time, color = hl ? k2Col : lvlCol)
            label.new(tX, p, (sg == 1 ? "+" : "-") + str.tostring(k), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = hl ? k2Col : lvlCol, size = size.tiny)
    active := h > 0
    o0     := na

bool isLastBar = active and not na(tStop) and time_close >= tStop
lastExitBar = strategy.closedtrades > 0 ? strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) : -1
k1RiskPts   = k1StopAtr * nz(atrDay)
enteredK2   = false

// ═════════════ K2: Reclaim-Logik (läuft immer mit, Entries nur wenn K2 gewählt)
if active and time < tStop and lvP.size() > 0
    rearm = rearmAtr * atrDay
    for i = 0 to lvP.size() - 1
        p  = lvP.get(i)
        sd = lvS.get(i)
        bool  recl   = false
        int   sTouch = na
        float ext    = na
        pend = lvPend.get(i)
        if pend >= 0
            e = sd == 1 ? math.min(lvExt.get(i), low) : math.max(lvExt.get(i), high)
            lvExt.set(i, e)
            if (sd == 1 ? close > p : close < p)
                recl   := true
                sTouch := pend
                ext    := e
                lvPend.set(i, -1)
            else if bar_index - pend >= reclaimBars
                lvPend.set(i, -1)
        else if lvArm.get(i) and lvN.get(i) < k2Touches
            touched = sd == 1 ? low <= p - syminfo.mintick : high >= p + syminfo.mintick
            if touched
                lvN.set(i, lvN.get(i) + 1)
                lvArm.set(i, false)
                e = sd == 1 ? low : high
                lvExt.set(i, e)
                if (sd == 1 ? close > p : close < p)
                    recl   := true
                    sTouch := bar_index
                    ext    := e
                else
                    lvPend.set(i, bar_index)
        if not lvArm.get(i) and (close - p) * sd >= rearm
            lvArm.set(i, true)

        if recl
            priorOk = not needPrior or (sd == 1 ? (not na(firstBear) and firstBear < sTouch) : (not na(firstBull) and firstBull < sTouch))
            momOk   = not needMom or (bar_index > sessBar0 and (sd == 1 ? (close > high[1] and close > open) : (close < low[1] and close < open)))
            if runK2 and lvK2.get(i) and priorOk and momOk and not isLastBar and not enteredK2 and strategy.position_size == 0 and lastExitBar < bar_index
                sStruct = ext - sd * syminfo.mintick
                stop    = sd == 1 ? math.min(sStruct, close - minStopAtr * atrDay) : math.max(sStruct, close + minStopAtr * atrDay)
                stop    := math.round_to_mintick(stop)
                tgt     = math.round_to_mintick(mid)
                risk    = math.abs(close - stop)
                if (tgt - close) * sd > 0 and risk > 0
                    qty = math.max(1, math.min(maxQty, math.floor(k2Risk / (risk * syminfo.pointvalue))))
                    id  = sd == 1 ? "K2 Long" : "K2 Short"
                    strategy.entry(id, sd == 1 ? strategy.long : strategy.short, qty = qty)
                    strategy.exit("Exit " + id, id, stop = stop, limit = tgt)
                    curStop   := stop
                    curTgt    := tgt
                    enteredK2 := true
                    rr = math.abs(tgt - close) / risk
                    label.new(bar_index, sd == 1 ? low : high, id + "\nRR " + str.tostring(rr, "#.0") + " | Stop " + str.tostring(risk, "#.00") + " Pkt\n" + str.tostring(qty) + " Kontr.", style = sd == 1 ? label.style_label_up : label.style_label_down, color = sd == 1 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
                    alert(id + " Entry " + str.tostring(close) + " Stop " + str.tostring(stop) + " Ziel " + str.tostring(tgt), alert.freq_once_per_bar_close)
            if sd == 1 and na(firstBull)
                firstBull := bar_index
            if sd == -1 and na(firstBear)
                firstBear := bar_index

// ═════════════ K1: Touch-Zähler, dann Limit-Orders für die NÄCHSTE Kerze
if active and time < tStop and aP.size() > 0
    rearm = rearmAtr * atrDay
    for i = 0 to aP.size() - 1
        p  = aP.get(i)
        sd = aS.get(i)
        if aArm.get(i) and aN.get(i) < k1Touches
            touched = sd == 1 ? low <= p - syminfo.mintick : high >= p + syminfo.mintick
            if touched
                aN.set(i, aN.get(i) + 1)
                aArm.set(i, false)
        if not aArm.get(i) and (close - p) * sd >= rearm
            aArm.set(i, true)

    flat     = strategy.position_size == 0 and not enteredK2
    inWindow = time_close >= tW1 and time_close < tW2 and time_close < tStop
    for i = 0 to aP.size() - 1
        p  = aP.get(i)
        sd = aS.get(i)
        id = (sd == 1 ? "K1 Long " : "K1 Short ") + str.tostring(i)
        ok = runK1 and flat and inWindow and not isLastBar and aArm.get(i) and aN.get(i) < k1Touches and (mid - p) * sd > 0 and k1RiskPts > 0 and (not needIct or inZone(p, sd))
        if ok
            lim  = math.round_to_mintick(p)
            stop = math.round_to_mintick(p - sd * k1RiskPts)
            qty  = math.max(1, math.min(maxQty, math.floor(k1Risk / (k1RiskPts * syminfo.pointvalue))))
            strategy.entry(id, sd == 1 ? strategy.long : strategy.short, qty = qty, limit = lim)
            strategy.exit("Exit " + id, id, stop = stop, limit = math.round_to_mintick(mid))
        else
            strategy.cancel(id)
            if strategy.position_size == 0 and not enteredK2
                strategy.cancel("Exit " + id)

// K1-Fill erkennen -> Stop/Ziel-Linien und Alert
if strategy.position_size != 0 and strategy.position_size[1] == 0 and strategy.opentrades > 0
    eid = strategy.opentrades.entry_id(0)
    if str.startswith(eid, "K1")
        curStop := math.round_to_mintick(strategy.position_avg_price - math.sign(strategy.position_size) * k1RiskPts)
        curTgt  := math.round_to_mintick(mid)
        alert(eid + " gefüllt @ " + str.tostring(strategy.position_avg_price) + " Stop " + str.tostring(curStop) + " Ziel " + str.tostring(curTgt), alert.freq_once_per_bar_close)

// ═════════════ Tagesende
if isLastBar
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment = "15:59")
    active := false

plot(strategy.position_size != 0 ? curStop : na, "Stop", color.red, 1, plot.style_linebr)
plot(strategy.position_size != 0 ? curTgt : na, "Ziel", color.green, 1, plot.style_linebr)

if barstate.islast and not (timeframe.isminutes and timeframe.multiplier == 1)
    label.new(bar_index, high, "Dieses Skript ist für den 1-Minuten-Chart gebaut.\nBitte Timeframe auf 1m stellen.", color = color.orange, textcolor = color.black)
