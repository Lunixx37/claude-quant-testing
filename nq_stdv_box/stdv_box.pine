//@version=6
// NQ Stdv Box
// Box zwischen dem Open der 00:00-ET-Kerze (06:00 DE) und dem Open der 08:30-ET-Kerze (14:30 DE).
// Mittellinie = 50 % der Box. Stdv-Projektionen mit halber Boxhöhe h:
//   Leg "oben -> Mitte"  => Level oberhalb:  Mitte + k*h
//   Leg "unten -> Mitte" => Level unterhalb: Mitte - k*h
// Optional: Signale = erster Touch eines Levels + Konfluenz (VWAP / Psych-Zahl) + Momentum-Kerze
// (identische Regeln wie im Python-Backtest nq_stdv_box/confluence.py).
indicator("NQ Stdv Box", overlay = true, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// ───────────── Inputs
grpT   = "Zeiten"
tz     = input.string("America/New_York", "Zeitzone", group = grpT)
sH     = input.int(0,  "Box-Start (Std : Min)",  minval = 0, maxval = 23, group = grpT, inline = "s")
sM     = input.int(0,  "",            minval = 0, maxval = 59, group = grpT, inline = "s")
eH     = input.int(8,  "Box-Ende (Std : Min)",   minval = 0, maxval = 23, group = grpT, inline = "e")
eM     = input.int(30, "",            minval = 0, maxval = 59, group = grpT, inline = "e")
xH     = input.int(16, "Linien enden um (Std)", minval = 0, maxval = 23, group = grpT)

grpL    = "Stdv-Level"
lvlStr  = input.string("2, 2.25, 2.5, 3.5, 4, 4.25, 4.5", "Multiplikatoren", group = grpL)
showLbl = input.bool(true, "Level beschriften", group = grpL)
boxCol  = input.color(color.new(color.blue, 80), "Box", group = grpL)
midCol  = input.color(color.white, "Mittellinie", group = grpL)
upCol   = input.color(color.new(color.gray, 30), "Level oben", group = grpL)
dnCol   = input.color(color.new(color.gray, 30), "Level unten", group = grpL)

grpS     = "Signale (Touch + Konfluenz + Momentum)"
showSig  = input.bool(true, "Signale anzeigen", group = grpS)
confMode = input.string("VWAP", "Konfluenz", options = ["Keine", "VWAP", "Psych 100", "Psych 50"], group = grpS)
tol      = input.float(5.0, "Toleranz (Punkte)", minval = 0, group = grpS)
momBars  = input.int(15, "Momentum-Fenster (Bars nach Touch)", minval = 0, group = grpS)
showVw   = input.bool(false, "ETH-VWAP ±1σ/±2σ plotten", group = grpS)

// ───────────── VWAP (Anker = Handelstag, bei CME-Futures 18:00 ET = ETH-VWAP)
newDay = timeframe.change("D")
[vw, up1, dn1] = ta.vwap(hlc3, newDay, 1.0)
[vw2, up2, dn2] = ta.vwap(hlc3, newDay, 2.0)
plot(showVw ? vw : na, "ETH-VWAP", color.orange)
plot(showVw ? up1 : na, "+1σ", color.new(color.orange, 50))
plot(showVw ? dn1 : na, "-1σ", color.new(color.orange, 50))
plot(showVw ? up2 : na, "+2σ", color.new(color.orange, 70))
plot(showVw ? dn2 : na, "-2σ", color.new(color.orange, 70))

// ───────────── Level-Multiplikatoren parsen
var array<float> mults = array.new<float>()
if barstate.isfirst
    for s in str.split(lvlStr, ",")
        v = str.tonumber(str.replace_all(s, " ", ""))
        if not na(v)
            mults.push(v)

// ───────────── Zeiten (erste Kerze mit Zeit >= Zielzeit, funktioniert auf allen Intraday-TFs)
y  = year(time, tz)
mo = month(time, tz)
d  = dayofmonth(time, tz)
tS = timestamp(tz, y, mo, d, sH, sM)
tE = timestamp(tz, y, mo, d, eH, eM)
tX = timestamp(tz, y, mo, d, xH, 0)
isStart = time >= tS and (na(time[1]) or time[1] < tS)
isEnd   = time >= tE and (na(time[1]) or time[1] < tE)
isStop  = time >= tX and (na(time[1]) or time[1] < tX)

// ───────────── State
var float o0     = na
var int   t0     = na
var int   tStop  = na
var bool  active = false
var array<float> lp = array.new<float>()   // Level-Preis
var array<int>   ls = array.new<int>()     // -1 = oben (Short-Fade), +1 = unten (Long-Fade)
var array<float> lk = array.new<float>()   // Multiplikator
var array<int>   lt = array.new<int>()     // bar_index des ersten Touches, -1 = noch nicht
var array<float> le = array.new<float>()   // Extrem seit Touch (für Stop)
var array<bool>  lc = array.new<bool>()    // Konfluenz beim Touch
var array<bool>  ld = array.new<bool>()    // erledigt

if isStart
    o0     := open
    t0     := time
    active := false

if isEnd and not na(o0)
    o830  = open
    top   = math.max(o0, o830)
    bot   = math.min(o0, o830)
    mid   = (top + bot) / 2
    h     = (top - bot) / 2
    tStop := tX
    box.new(t0, top, tX, bot, xloc = xloc.bar_time, bgcolor = boxCol, border_color = color.new(color.blue, 40))
    line.new(t0, mid, tX, mid, xloc = xloc.bar_time, color = midCol)
    lp.clear()
    ls.clear()
    lk.clear()
    lt.clear()
    le.clear()
    lc.clear()
    ld.clear()
    for k in mults
        for sd in array.from(-1, 1)
            p = mid - sd * k * h
            line.new(time, p, tX, p, xloc = xloc.bar_time, color = sd == -1 ? upCol : dnCol)
            if showLbl
                label.new(tX, p, str.tostring(k), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = sd == -1 ? upCol : dnCol, size = size.tiny)
            lp.push(p)
            ls.push(sd)
            lk.push(k)
            lt.push(-1)
            le.push(na)
            lc.push(false)
            ld.push(false)
    active := h > 0
    o0     := na

if isStop
    active := false

// ───────────── Signale
if active and showSig and time < tStop and lp.size() > 0
    for i = 0 to lp.size() - 1
        if ld.get(i)
            continue
        p  = lp.get(i)
        sd = ls.get(i)
        if lt.get(i) < 0
            touched = sd == -1 ? high >= p : low <= p
            if touched
                lt.set(i, bar_index)
                le.set(i, sd == -1 ? high : low)
                float dist = switch confMode
                    "VWAP"      => math.min(math.abs(p - vw), math.abs(p - up1), math.abs(p - dn1), math.abs(p - up2), math.abs(p - dn2))
                    "Psych 100" => math.abs(p - math.round(p / 100) * 100)
                    "Psych 50"  => math.abs(p - math.round(p / 50) * 50)
                    => 0.0
                lc.set(i, dist <= tol)
        if lt.get(i) >= 0
            le.set(i, sd == -1 ? math.max(le.get(i), high) : math.min(le.get(i), low))
            trig = sd == -1 ? (close < p and close < low[1] and close < open) : (close > p and close > high[1] and close > open)
            if trig and lc.get(i)
                stop = sd == -1 ? le.get(i) + syminfo.mintick : le.get(i) - syminfo.mintick
                risk = math.abs(close - stop)
                tip  = "Level " + str.tostring(lk.get(i)) + "\nEntry " + str.tostring(close) + "\nStop " + str.tostring(stop) + "\n2R " + str.tostring(close + sd * 2 * risk)
                label.new(bar_index, sd == -1 ? high : low, sd == -1 ? "S" : "L", style = sd == -1 ? label.style_label_down : label.style_label_up, color = sd == -1 ? color.red : color.green, textcolor = color.white, size = size.small, tooltip = tip)
                alert("NQ Stdv Box " + (sd == -1 ? "SHORT" : "LONG") + " @ " + str.tostring(close) + " | " + tip, alert.freq_once_per_bar_close)
                ld.set(i, true)
            else if trig or bar_index - lt.get(i) >= momBars
                ld.set(i, true)
