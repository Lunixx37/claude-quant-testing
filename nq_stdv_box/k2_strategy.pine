//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// NQ Stdv Box – Strategie K2            (nur auf dem 1-MINUTEN-Chart verwenden, NQ / MNQ)
//
// Box   : Open der 00:00-ET-Kerze bis Open der 08:30-ET-Kerze, Mitte = 50 %, h = halbe Boxhöhe
// Level : Mitte ± k·h  (k = 2, 2.25, 2.5, 3.5, 4, 4.25, 4.5) + beide Box-Kanten
//
// K2-Regeln (identisch zum Python-Backtest, 08:30–16:00 ET):
//   1. Touch   : Preis handelt mind. 1 Tick DURCH das 3.5-Level (−3.5 von oben = Long, +3.5 von unten = Short).
//                Pro Level und Tag max. N Touches; ein Level wird erst wieder "scharf", wenn eine Kerze
//                mind. 0,02·ATR auf der Ausgangsseite schließt.
//   2. Reclaim : innerhalb von 10 Kerzen schließt eine 1-Min-Kerze wieder auf der Ausgangsseite.
//   3. Momentum: diese Kerze schließt über dem Hoch der Vorkerze (Short: unter dem Tief) und in Trade-Richtung.
//   4. Vorher  : vor dem Touch gab es heute bereits einen Reclaim in die GEGENRICHTUNG an irgendeinem Level
//                (Box-Kanten oder Stdv-Level).
//   5. Entry   : Schlusskurs der Reclaim-Kerze. Stop: hinter dem Sweep-Extrem (+1 Tick), mind. 0,02·ATR.
//                Ziel: Box-Mitte. Spätestens 15:59 ET wird glattgestellt. Nur eine Position gleichzeitig.
//   ATR = Durchschnitt der Tagesrange (High−Low) der letzten 14 abgeschlossenen Handelstage.
//
// Lockerungen (Einstellungen): "Max. Touches" 3 → 6 (≈ 3,6 statt 2,3 Trades/Woche im Backtest),
// "Vorherige Gegenreaktion nötig" aus, "Reclaim-Fenster" 10 → 30.
// ─────────────────────────────────────────────────────────────────────────────────────────────
strategy("NQ Stdv Box – K2", overlay = true, process_orders_on_close = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.6, slippage = 1,
     max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// ───────────── Inputs
grpT = "Zeiten"
tz   = input.string("America/New_York", "Zeitzone", group = grpT)
sH   = input.int(0,  "Box-Start (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "s")
sM   = input.int(0,  "",           minval = 0, maxval = 59, group = grpT, inline = "s")
eH   = input.int(8,  "Box-Ende (Std : Min)",  minval = 0, maxval = 23, group = grpT, inline = "e")
eM   = input.int(30, "",           minval = 0, maxval = 59, group = grpT, inline = "e")
xH   = input.int(16, "Handelsende (Std)", minval = 0, maxval = 23, group = grpT)

grpK = "K2-Regeln"
k2Level     = input.float(3.5, "Setup-Level (Stdv)", group = grpK)
maxTouches  = input.int(3, "Max. Touches pro Level und Tag (Basis 3, gelockert 6)", minval = 1, maxval = 10, group = grpK)
reclaimBars = input.int(10, "Reclaim-Fenster in Kerzen (Basis 10)", minval = 0, maxval = 60, group = grpK)
needPrior   = input.bool(true, "Vorherige Gegenreaktion nötig", group = grpK)
needMom     = input.bool(true, "Momentum-Kerze nötig", group = grpK)
minStopAtr  = input.float(0.02, "Mindest-Stop (× ATR)", minval = 0, step = 0.005, group = grpK)
rearmAtr    = input.float(0.02, "Re-Arm-Abstand (× ATR)", minval = 0, step = 0.005, group = grpK)

grpR = "Positionsgröße"
riskUsd = input.float(200, "Risiko pro Trade ($)", minval = 1, group = grpR)
maxQty  = input.int(50, "Max. Kontrakte", minval = 1, group = grpR)

grpV = "Darstellung"
showAll = input.bool(true, "Alle Stdv-Level zeichnen", group = grpV)
boxCol  = input.color(color.new(color.blue, 80), "Box", group = grpV)
midCol  = input.color(color.white, "Mittellinie", group = grpV)
lvlCol  = input.color(color.new(color.gray, 40), "Level", group = grpV)
k2Col   = input.color(color.new(color.red, 0), "Setup-Level", group = grpV)

// ───────────── ATR14 der letzten 14 abgeschlossenen Handelstage (kein Repainting)
atrD = request.security(syminfo.tickerid, "D", ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_on)

// ───────────── Zeiten
y  = year(time, tz)
mo = month(time, tz)
d  = dayofmonth(time, tz)
tS = timestamp(tz, y, mo, d, sH, sM)
tE = timestamp(tz, y, mo, d, eH, eM)
tX = timestamp(tz, y, mo, d, xH, 0)
isStart = time >= tS and (na(time[1]) or time[1] < tS)
isEnd   = time >= tE and (na(time[1]) or time[1] < tE)

// ───────────── State
var float o0       = na
var int   t0       = na
var int   tStop    = na
var bool  active   = false
var float mid      = na
var float atrDay   = na
var int   sessBar0 = na
var int   firstBull = na     // frühester bullischer Reclaim des Tages (bar_index)
var int   firstBear = na
var float curStop  = na
var float curTgt   = na

var array<float> mults  = array.from(2.0, 2.25, 2.5, 3.5, 4.0, 4.25, 4.5)
var array<float> lvP    = array.new<float>()   // Level-Preis
var array<int>   lvS    = array.new<int>()     // +1 = Support (Long), −1 = Resistance (Short)
var array<bool>  lvK2   = array.new<bool>()    // Setup-Level?
var array<bool>  lvArm  = array.new<bool>()
var array<int>   lvPend = array.new<int>()     // Touch-Bar eines offenen Reclaim-Fensters, −1 = keins
var array<float> lvExt  = array.new<float>()   // Sweep-Extrem
var array<int>   lvN    = array.new<int>()     // Anzahl Touches heute

addLevel(float p, bool isK2, float rearm) =>
    for sd in array.from(1, -1)
        lvP.push(p)
        lvS.push(sd)
        lvK2.push(isK2)
        lvArm.push((open - p) * sd >= rearm)
        lvPend.push(-1)
        lvExt.push(na)
        lvN.push(0)

if isStart
    o0     := open
    t0     := time
    active := false

if isEnd and not na(o0) and not na(atrD)
    o830   = open
    top    = math.max(o0, o830)
    bot    = math.min(o0, o830)
    h      = (top - bot) / 2
    mid      := (top + bot) / 2
    atrDay   := atrD
    tStop    := tX
    sessBar0 := bar_index
    firstBull := na
    firstBear := na
    lvP.clear()
    lvS.clear()
    lvK2.clear()
    lvArm.clear()
    lvPend.clear()
    lvExt.clear()
    lvN.clear()
    rearm = rearmAtr * atrDay
    box.new(t0, top, tX, bot, xloc = xloc.bar_time, bgcolor = boxCol, border_color = color.new(color.blue, 40))
    line.new(t0, mid, tX, mid, xloc = xloc.bar_time, color = midCol)
    addLevel(o0, false, rearm)
    addLevel(o830, false, rearm)
    for k in mults
        isK2 = math.abs(k - k2Level) < 0.0001
        for sg in array.from(1, -1)
            p = mid + sg * k * h
            addLevel(p, isK2, rearm)
            if showAll or isK2
                line.new(time, p, tX, p, xloc = xloc.bar_time, color = isK2 ? k2Col : lvlCol)
                label.new(tX, p, (sg == 1 ? "+" : "-") + str.tostring(k), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = isK2 ? k2Col : lvlCol, size = size.tiny)
    active := h > 0
    o0     := na

bool isLastBar = active and not na(tStop) and time_close >= tStop
lastExitBar = strategy.closedtrades > 0 ? strategy.closedtrades.exit_bar_index(strategy.closedtrades - 1) : -1

// ───────────── Level-Logik + Signale
if active and time < tStop and lvP.size() > 0
    rearm   = rearmAtr * atrDay
    entered = false
    for i = 0 to lvP.size() - 1
        p  = lvP.get(i)
        sd = lvS.get(i)
        bool  recl   = false
        int   sTouch = na
        float ext    = na
        pend = lvPend.get(i)
        if pend >= 0
            e = sd == 1 ? math.min(lvExt.get(i), low) : math.max(lvExt.get(i), high)
            lvExt.set(i, e)
            if (sd == 1 ? close > p : close < p)
                recl   := true
                sTouch := pend
                ext    := e
                lvPend.set(i, -1)
            else if bar_index - pend >= reclaimBars
                lvPend.set(i, -1)
        else if lvArm.get(i) and lvN.get(i) < maxTouches
            touched = sd == 1 ? low <= p - syminfo.mintick : high >= p + syminfo.mintick
            if touched
                lvN.set(i, lvN.get(i) + 1)
                lvArm.set(i, false)
                e = sd == 1 ? low : high
                lvExt.set(i, e)
                if (sd == 1 ? close > p : close < p)
                    recl   := true
                    sTouch := bar_index
                    ext    := e
                else
                    lvPend.set(i, bar_index)
        if not lvArm.get(i) and (close - p) * sd >= rearm
            lvArm.set(i, true)

        if recl
            // --- K2-Signal prüfen (vorherige Gegenreaktion muss VOR dem Touch abgeschlossen sein)
            priorOk = not needPrior or (sd == 1 ? (not na(firstBear) and firstBear < sTouch) : (not na(firstBull) and firstBull < sTouch))
            momOk   = not needMom or (bar_index > sessBar0 and (sd == 1 ? (close > high[1] and close > open) : (close < low[1] and close < open)))
            if lvK2.get(i) and priorOk and momOk and not isLastBar and not entered and strategy.position_size == 0 and lastExitBar < bar_index
                sStruct = ext - sd * syminfo.mintick
                stop    = sd == 1 ? math.min(sStruct, close - minStopAtr * atrDay) : math.max(sStruct, close + minStopAtr * atrDay)
                stop    := math.round_to_mintick(stop)
                tgt     = math.round_to_mintick(mid)
                risk    = math.abs(close - stop)
                if (tgt - close) * sd > 0 and risk > 0
                    qty = math.max(1, math.min(maxQty, math.floor(riskUsd / (risk * syminfo.pointvalue))))
                    id  = sd == 1 ? "K2 Long" : "K2 Short"
                    strategy.entry(id, sd == 1 ? strategy.long : strategy.short, qty = qty)
                    strategy.exit("Exit " + id, id, stop = stop, limit = tgt)
                    curStop := stop
                    curTgt  := tgt
                    entered := true
                    rr = math.abs(tgt - close) / risk
                    label.new(bar_index, sd == 1 ? low : high, (sd == 1 ? "K2 Long" : "K2 Short") + "\nRR " + str.tostring(rr, "#.0") + " | Stop " + str.tostring(risk, "#.00") + " Pkt\n" + str.tostring(qty) + " Kontr.", style = sd == 1 ? label.style_label_up : label.style_label_down, color = sd == 1 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
                    alert("K2 " + (sd == 1 ? "LONG" : "SHORT") + " Entry " + str.tostring(close) + " Stop " + str.tostring(stop) + " Ziel " + str.tostring(tgt), alert.freq_once_per_bar_close)
            // --- Reclaim für die "vorherige Reaktion" merken (frühester je Richtung)
            if sd == 1 and na(firstBull)
                firstBull := bar_index
            if sd == -1 and na(firstBear)
                firstBear := bar_index

// ───────────── Tagesende
if isLastBar
    if strategy.position_size != 0
        strategy.close_all(comment = "15:59")
    active := false

plot(strategy.position_size != 0 ? curStop : na, "Stop", color.red, 1, plot.style_linebr)
plot(strategy.position_size != 0 ? curTgt : na, "Ziel", color.green, 1, plot.style_linebr)

if barstate.islast and not (timeframe.isminutes and timeframe.multiplier == 1)
    label.new(bar_index, high, "K2 ist für den 1-Minuten-Chart gebaut.\nBitte Timeframe auf 1m stellen.", color = color.orange, textcolor = color.black)
