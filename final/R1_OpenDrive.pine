//@version=6
// ─────────────────────────────────────────────────────────────────────────────────────────────
// NQ Open-Drive – Fortsetzung nach starkem Weglaufen von der Eröffnung
// Nur auf dem 1-MINUTEN-Chart verwenden (NQ / MNQ, Zeiten in New Yorker Zeit, volle Handelszeit).
//
// Einstieg (identisch zum Python-Backtest final/r1_strategy.py):
//   ATR    : Durchschnitt der Tagesspanne (Hoch − Tief) der letzten 14 abgeschlossenen Handelstage
//   O      : Eröffnungskurs der 09:30-Kerze
//   Signal : erste 1-Min-Kerze ab 09:31, die ≥ O + 0,3·ATR schließt (Long) oder ≤ O − 0,3·ATR (Short)
//   Filter : Tagesspanne seit 09:30 (Hoch − Tief inkl. Signalkerze) ≤ 0,5·ATR; Signal spätestens 15:29
//   Entry  : Schlusskurs der Signalkerze, höchstens 1 Trade pro Tag
//
// Auf dem Chart: blaue Linie = Entry, rot gestrichelt = Anfangs-Stop, rote Linie = aktueller Stop
// (Einstand / Nachzug), grün gestrichelt = Ziel 1, Beschriftung "Exit … R" an jedem Ausstieg.
//
// Ausstiegs-Modi (Backtest CFD 2016–22 / NQ 2023–25, 1 Punkt Kosten je Kontrakt und Trade):
//   "Nur Runner" (Trend, Standard): Stop 0,08·ATR, kein Ziel, bis 15:59 halten.
//        22 % Treffer, Ø Gewinn +5,3 R, Ø Verlust −1,0 R, +0,37 / +0,30 R je Trade, ≈ +57 R pro Jahr,
//        größter Drawdown −34 R, längste Verlustserie 24 Trades.
//   "Nur Runner" + Kerzen-Nachzug: sobald der Trade 1 × Stop im Gewinn schließt, wandert der Stop nach
//        jeder 1-Min-Kerze in Trade-Richtung auf deren Open.
//        49 % Treffer, +0,11 / +0,12 R je Trade, ≈ +18 R pro Jahr, längste Verlustserie 7 Trades.
//   "Teilverkauf + Runner" (V2a): Stop 0,15·ATR, halbe Position bei 0,5 × Stop, danach Stop auf
//        Einstand, Rest bis 15:59. 70–73 % Treffer, +0,15 / +0,06 R je Trade; auf NQ seit Juli 2024
//        nur bei null. Braucht mindestens 2 Kontrakte.
//   "Festes Ziel" (R1): Stop 0,15·ATR, ganze Position bei 0,5 × Stop. 70–73 % Treffer, +0,08 / +0,04 R.
// ─────────────────────────────────────────────────────────────────────────────────────────────
strategy("NQ Open-Drive", overlay = true, process_orders_on_close = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.6, slippage = 1,
     max_lines_count = 500, max_labels_count = 500)

// ───────────── Inputs
string grpT = "Zeiten"
string tz   = input.string("America/New_York", "Zeitzone", group = grpT)
int openH   = input.int(9,  "Eröffnung (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "o")
int openM   = input.int(30, "", minval = 0, maxval = 59, group = grpT, inline = "o")
int lastH   = input.int(15, "Letztes Signal (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "l")
int lastM   = input.int(29, "", minval = 0, maxval = 59, group = grpT, inline = "l")
int flatH   = input.int(15, "Glattstellen (Std : Min)", minval = 0, maxval = 23, group = grpT, inline = "f")
int flatM   = input.int(59, "", minval = 0, maxval = 59, group = grpT, inline = "f")

string grpS = "Einstieg"
float trigMult = input.float(0.30, "Signal: Abstand zur Eröffnung (× ATR)", minval = 0.05, step = 0.05, group = grpS)
bool useRange  = input.bool(true, "Filter: Tagesspanne begrenzen", group = grpS)
float rngMax   = input.float(0.50, "Max. Tagesspanne beim Signal (× ATR)", minval = 0.1, step = 0.05, group = grpS)
string sideSel = input.string("Beide", "Richtung", options = ["Beide", "Nur Long", "Nur Short"], group = grpS)

string grpX = "Ausstieg"
string modeRun  = "Nur Runner"
string modePart = "Teilverkauf + Runner"
string modeFix  = "Festes Ziel"
string exitMode = input.string("Nur Runner", "Modus", options = ["Nur Runner", "Teilverkauf + Runner", "Festes Ziel"], group = grpX)
float stopRunMult = input.float(0.08, "Stop im Modus 'Nur Runner' (× ATR)", minval = 0.02, step = 0.01, group = grpX)
float stopStdMult = input.float(0.15, "Stop in den anderen Modi (× ATR)", minval = 0.02, step = 0.01, group = grpX)
float rrMult   = input.float(0.50, "Ziel 1 (× Stop), nicht für 'Nur Runner'", minval = 0.1, step = 0.05, group = grpX)
float partPct  = input.float(50, "Teilverkauf: Anteil der Position (%)", minval = 1, maxval = 99, step = 1, group = grpX)
bool moveBE    = input.bool(true, "Nach Teilverkauf: Stop des Rests auf Einstand", group = grpX)
float runRR    = input.float(0.0, "Ziel für den Rest (× Stop, 0 = bis Tagesende halten)", minval = 0, step = 0.5, group = grpX)

string grpN = "Kerzen-Nachzug"
bool useTrail  = input.bool(false, "Stop auf das Open der Kerzen in Trade-Richtung nachziehen", group = grpN)
float trailAct = input.float(1.0, "Aktiv, sobald der Trade so weit im Gewinn schließt (× Stop)", minval = 0, step = 0.5, group = grpN)
int trailK     = input.int(1, "Kerzen in Folge in Trade-Richtung (1 = jede Kerze)", minval = 1, maxval = 10, group = grpN)

string grpR = "Positionsgröße"
float riskUsd = input.float(200, "Risiko pro Trade ($)", minval = 1, group = grpR)
int maxQty    = input.int(50, "Max. Kontrakte", minval = 1, group = grpR)

string grpF = "Forward-Test"
bool fwdOnly  = input.bool(false, "Nur ab Startdatum handeln", group = grpF)
int fwdStart  = input.time(timestamp("16 Nov 2026 00:00:00 GMT-5"), "Startdatum", group = grpF)

string grpV = "Darstellung"
bool showLvl  = input.bool(true, "Eröffnung und Signal-Level zeichnen", group = grpV)
bool showTrade = input.bool(true, "Entry, Stop, Ziel und Exit je Trade markieren", group = grpV)
bool showInfo = input.bool(true, "Info-Tabelle", group = grpV)
color openCol = input.color(color.new(color.gray, 0), "Eröffnung", group = grpV)
color trigCol = input.color(color.new(color.orange, 0), "Signal-Level", group = grpV)

if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Dieses Skript ist für den 1-Minuten-Chart gebaut.")

float stopMult = exitMode == modeRun ? stopRunMult : stopStdMult

// ───────────── ATR der letzten 14 abgeschlossenen Handelstage (kein Repainting)
float atrD = request.security(syminfo.tickerid, "D", ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_on)

// ───────────── Zeiten
int y    = year(time, tz)
int mo   = month(time, tz)
int d    = dayofmonth(time, tz)
int mins = hour(time, tz) * 60 + minute(time, tz)
int openMin = openH * 60 + openM
int lastMin = lastH * 60 + lastM
int flatMin = flatH * 60 + flatM
bool newDay    = na(time[1]) or d != dayofmonth(time[1], tz)
bool isOpenBar = mins == openMin
bool inSession = mins >= openMin and mins <= flatMin

// ───────────── Tageszustand
var float o      = na
var float dayHi  = na
var float dayLo  = na
var float atrDay = na
var bool  done   = true
// ───────────── Trade-Zustand
var float entryPx = na
var float curStop = na
var float tpPx    = na
var float distPts = na
var int   posQty  = 0
var int   q1Qty   = 0
var int   dirSign = 0
var bool  beSet   = false
var bool  trailOn = false
var int   streak  = 0
// ───────────── Markierungen des laufenden Trades
var line entryLn = na
var line stopLn  = na
var line tpLn    = na

if newDay
    o := na
    done := true
if isOpenBar
    o := open
    dayHi := high
    dayLo := low
    atrDay := atrD
    done := false
else if inSession and not na(o)
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)

float upLvl = o + trigMult * atrDay
float dnLvl = o - trigMult * atrDay

// ───────────── Level zeichnen
if isOpenBar and showLvl and not na(atrDay)
    int tEnd = timestamp(tz, y, mo, d, flatH, flatM)
    line.new(time, o, tEnd, o, xloc = xloc.bar_time, color = openCol, style = line.style_dotted, width = 1)
    line.new(time, upLvl, tEnd, upLvl, xloc = xloc.bar_time, color = trigCol, style = line.style_dashed, width = 1)
    line.new(time, dnLvl, tEnd, dnLvl, xloc = xloc.bar_time, color = trigCol, style = line.style_dashed, width = 1)

// ───────────── Offene Position verwalten (geänderte Stops gelten ab der nächsten Kerze)
int openQty = int(math.abs(strategy.position_size))
if openQty > 0 and dirSign != 0
    bool stopChanged = false
    // Teilverkauf ist erfolgt -> Stop des Rests auf Einstand
    if exitMode == modePart and moveBE and not beSet and openQty < posQty
        beSet := true
        if (entryPx - curStop) * dirSign > 0
            curStop := entryPx
            stopChanged := true
    // Kerzen-Nachzug: Stop auf das Open der ersten von trailK Kerzen in Folge in Trade-Richtung
    if not trailOn and (close - entryPx) * dirSign >= trailAct * distPts
        trailOn := true
    streak := (close - open) * dirSign > 0 ? streak + 1 : 0
    if useTrail and trailOn and streak >= trailK
        float ns = open[trailK - 1]
        if (ns - curStop) * dirSign > 0 and (close - ns) * dirSign > 0
            curStop := ns
            stopChanged := true
    if stopChanged
        string rid = dirSign == 1 ? "Long" : "Short"
        float runLimit = runRR > 0 ? entryPx + dirSign * distPts * runRR : na
        if exitMode == modeRun
            strategy.exit(rid + " Rest", rid, stop = curStop)
        else if exitMode == modeFix or posQty < 2
            strategy.exit(rid + " Ziel", rid, stop = curStop, limit = tpPx)
        else if openQty == posQty
            strategy.exit(rid + " Ziel", rid, qty = q1Qty, stop = curStop, limit = tpPx)
            strategy.exit(rid + " Rest", rid, qty = posQty - q1Qty, stop = curStop, limit = runLimit)
        else
            strategy.exit(rid + " Rest", rid, qty = openQty, stop = curStop, limit = runLimit)

// ───────────── Signal
bool canTrade = not fwdOnly or time >= fwdStart
bool window   = inSession and mins > openMin and mins <= lastMin
bool upSig    = window and not done and not na(o) and not na(atrDay) and close >= upLvl
bool dnSig    = window and not done and not na(o) and not na(atrDay) and close <= dnLvl

if upSig or dnSig
    done := true                                   // nur das erste Signal des Tages zählt
    bool rangeOk = not useRange or (dayHi - dayLo) <= rngMax * atrDay
    bool sideOk  = sideSel == "Beide" or (upSig and sideSel == "Nur Long") or (dnSig and sideSel == "Nur Short")
    if rangeOk and sideOk and canTrade and strategy.position_size == 0
        float dist = stopMult * atrDay
        int qty = int(math.max(1, math.min(maxQty, math.floor(riskUsd / (dist * syminfo.pointvalue)))))
        int sgn = upSig ? 1 : -1
        string id = upSig ? "Long" : "Short"
        entryPx := close
        distPts := dist
        curStop := close - sgn * dist
        tpPx := close + sgn * dist * rrMult
        posQty := qty
        q1Qty := int(math.max(1, math.min(qty - 1, math.round(qty * partPct / 100.0))))
        dirSign := sgn
        beSet := false
        trailOn := false
        streak := 0
        float runLimit0 = runRR > 0 ? close + sgn * dist * runRR : na
        strategy.entry(id, upSig ? strategy.long : strategy.short, qty = qty)
        if exitMode == modeRun
            strategy.exit(id + " Rest", id, stop = curStop)
        else if exitMode == modeFix or qty < 2
            strategy.exit(id + " Ziel", id, stop = curStop, limit = tpPx)
        else
            strategy.exit(id + " Ziel", id, qty = q1Qty, stop = curStop, limit = tpPx)
            strategy.exit(id + " Rest", id, qty = qty - q1Qty, stop = curStop, limit = runLimit0)
        alert("Open-Drive " + (upSig ? "LONG" : "SHORT") + "  Entry " + str.tostring(close, format.mintick) + "  Stop " + str.tostring(curStop, format.mintick), alert.freq_once_per_bar_close)
        label.new(time, close, upSig ? "Long" : "Short", xloc = xloc.bar_time,
             style = upSig ? label.style_label_up : label.style_label_down,
             yloc = upSig ? yloc.belowbar : yloc.abovebar, color = upSig ? color.green : color.red,
             textcolor = color.white, size = size.small)
        if showTrade
            entryLn := line.new(time, close, time, close, xloc = xloc.bar_time, color = color.blue, width = 2)
            stopLn := line.new(time, curStop, time, curStop, xloc = xloc.bar_time, color = color.red, style = line.style_dashed, width = 1)
            label.new(time, close, "Entry " + str.tostring(close, format.mintick), xloc = xloc.bar_time, style = label.style_label_right, color = color.blue, textcolor = color.white, size = size.small)
            label.new(time, curStop, "Stop " + str.tostring(curStop, format.mintick), xloc = xloc.bar_time, style = label.style_label_right, color = color.red, textcolor = color.white, size = size.small)
            if exitMode != modeRun
                tpLn := line.new(time, tpPx, time, tpPx, xloc = xloc.bar_time, color = color.green, style = line.style_dashed, width = 1)
                label.new(time, tpPx, "Ziel 1 " + str.tostring(tpPx, format.mintick), xloc = xloc.bar_time, style = label.style_label_right, color = color.green, textcolor = color.white, size = size.small)
            else
                tpLn := na

// ───────────── Tagesende: glattstellen
if strategy.position_size != 0 and (mins >= flatMin or mins < openMin)
    strategy.close_all(comment = "Zeit")

// ───────────── Trade-Markierungen: Linien bis zum Ausstieg ziehen, jeden Ausstieg beschriften
int nClosed = strategy.closedtrades
int nPrev   = nz(strategy.closedtrades[1])
if showTrade
    if strategy.position_size != 0
        line.set_x2(entryLn, time)
        line.set_x2(stopLn, time)
        line.set_x2(tpLn, time)
    if nClosed > nPrev
        for i = nPrev to nClosed - 1
            float xp = strategy.closedtrades.exit_price(i)
            float ep = strategy.closedtrades.entry_price(i)
            int xt   = strategy.closedtrades.exit_time(i)
            float sz = strategy.closedtrades.size(i)
            float resR = distPts > 0 ? (xp - ep) * math.sign(sz) / distPts : na
            label.new(xt, xp, "Exit " + str.tostring(xp, format.mintick) + "  " + (resR >= 0 ? "+" : "") + str.tostring(resR, "#.##") + " R", xloc = xloc.bar_time, style = label.style_label_left, color = resR >= 0 ? color.green : color.red, textcolor = color.white, size = size.small)
            if strategy.position_size == 0
                line.set_x2(entryLn, xt)
                line.set_x2(stopLn, xt)
                line.set_x2(tpLn, xt)

// ───────────── Stop und Ziel anzeigen
plot(strategy.position_size != 0 ? curStop : na, "Aktueller Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 and exitMode != modeRun ? tpPx : na, "Ziel 1", color = color.green, style = plot.style_linebr, linewidth = 1)

// ───────────── Info
var table info = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 70), border_width = 1)
if showInfo and barstate.islast and not na(atrDay)
    float distL = stopMult * atrDay
    int qtyL = int(math.max(1, math.min(maxQty, math.floor(riskUsd / (distL * syminfo.pointvalue)))))
    table.cell(info, 0, 0, "ATR (14 Tage)", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, str.tostring(atrDay, "#.0"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 1, "Signal ±", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 1, str.tostring(trigMult * atrDay, "#.0"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 2, "Stop (Punkte)", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 2, str.tostring(distL, "#.0"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 3, "Ziel 1 (Punkte)", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 3, exitMode == modeRun ? "keins" : str.tostring(distL * rrMult, "#.0"), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 4, "Kontrakte", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 4, str.tostring(qtyL), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 5, "Modus", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 5, (exitMode == modePart and qtyL < 2 ? "Festes Ziel (nur 1 Kontrakt)" : exitMode) + (useTrail ? " + Nachzug" : ""), text_color = color.white, text_size = size.small)
    table.cell(info, 0, 6, "Heute", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 6, done ? "Signal verbraucht" : "wartet", text_color = color.white, text_size = size.small)
