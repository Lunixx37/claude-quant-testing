// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// NY Volatility Breakout Bot (V6 result) - NQ / MNQ / NAS100 CFD, 1-minute chart
//
// Rules (mirror research/lab.py fam_vbo2, see research/V6_REPORT.md):
//   * Prior RTH range PR = high - low of the previous NY regular session (09:30-16:00).
//   * Triggers: UP = today's 09:30 open + k*PR, DN = 09:30 open - k*PR.
//   * First 1-min bar (09:30-15:59 NY) whose high >= UP (long) / low <= DN (short, if enabled):
//     market order at the next bar's open. Max 1 trade per day.
//   * Initial stop = stopMult * k * PR from the fill. R-step trailing: at +nR open profit (MFE)
//     the stop moves to entry + (n - lag) R; updated at bar close, active from the next bar.
//   * Exit at the close of the 15:59 bar (or the last bar of the session). No overnight positions.
// No lookahead: PR comes from the completed prior session, decisions at bar close, fills at the next open.
// Research (net of costs): 1/day long-only E +0.18 R (CFD 2017-25, 9/9 years positive).
// V7 prop default: both sides, k 0.35, stop 0.75x, max 2 trades/day: ~32 trades/month, E +0.14 R on NQ 2023-25;
// prop sizing $500 risk/trade in eval, $250 in funded (research/V7_REPORT.md). Use MNQ (qtyStep 1).
// Paper-trade first.
//@version=6
strategy("NY Volatility Breakout Bot", shorttitle = "VBO-Bot", overlay = true, pyramiding = 0,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.75, slippage = 1,
     process_orders_on_close = false, calc_on_every_tick = false)

TZ = "America/New_York"
grpS = "Signal"
k        = input.float(0.35, "k (breakout distance = k x prior RTH range)", step = 0.05, group = grpS)
stopMult = input.float(0.75, "Stop = x * (k x prior range)", step = 0.25, group = grpS)
side     = input.string("Both", "Direction", options = ["Long only", "Both"], group = grpS)
maxTrades = input.int(2, "Max trades per day (re-entry on the next trigger touch after an exit)", minval = 1, maxval = 3, group = grpS)
useTrail = input.bool(true, "R-step trailing stop", group = grpS)
cutR     = input.float(1.0, "Initial stop at x * R (1.0 = normal; 0.9 = cut losses slightly earlier, trailing still in R)", step = 0.05, minval = 0.5, maxval = 1.0, group = grpS)
lag      = input.float(1.25, "Trailing lag (R): 1.25 = max payouts, 0.75 = win rate ~53% (stop to +0.25R at +1R)", step = 0.25, group = grpS)
gapFilt  = input.bool(false, "Skip small-gap days (fewer blown accounts)", group = grpS)
usePoc   = input.bool(false, "Take profit at prior RTH volume POC (if >= min R away)", group = grpS)
pocMinR  = input.float(1.5, "POC target: min distance (R)", step = 0.25, group = grpS)
pocMaxR  = input.float(8.0, "POC target: max distance (R)", step = 0.5, group = grpS)
gapLo    = input.float(-0.405, "Skip if directional gap/ATR14 >", step = 0.01, group = grpS)
gapHi    = input.float(0.079, "... and <=", step = 0.01, group = grpS)
grpR = "Risk"
riskMode = input.string("Prop phase $", "Sizing", options = ["Prop phase $", "% of equity", "Fixed $", "Fixed qty"], group = grpR)
propPhase = input.string("Eval", "Prop phase", options = ["Eval", "Funded"], group = grpR)
riskEval = input.float(500, "Prop: $ risk per trade in EVAL", group = grpR)
riskFund = input.float(250, "Prop: $ risk per trade in FUNDED", group = grpR)
riskPct  = input.float(1.0, "Risk % of equity per trade", step = 0.25, group = grpR)
riskUsd  = input.float(250, "Fixed $ risk per trade", group = grpR)
fixedQty = input.float(1, "Fixed quantity", group = grpR)
qtyStep  = input.float(1, "Quantity step (1 for futures, 0.01 for CFD lots)", group = grpR)

modNow = hour(time, TZ) * 60 + minute(time, TZ)
inRTH  = modNow >= 570 and modNow < 960
newDay = ta.change(time("D")) != 0

// ---- prior RTH range and today's 09:30 open
var float rthH = na
var float rthL = na
var float prevRange = na
var float open930 = na
var float lastRthClose = na
var float pc = na
var array<float> rngHist = array.new_float(0)
var map<int, float> volBins = map.new<int, float>()      // prior-session volume by price bin (for the POC target)
var float binW = na
var float prevPoc = na
var int   tradesToday = 0
var bool  dayDone = false
if newDay
    tradesToday := 0
    dayDone := false
    open930 := na
if inRTH and modNow == 959
    lastRthClose := close                   // 15:59 bar close = RTH close
if inRTH and modNow == 570
    pc := lastRthClose
    // POC of the completed prior RTH session = bin with the highest volume
    if map.size(volBins) > 0 and not na(binW)
        float bestV = -1.0
        int bestK = 0
        for kk in map.keys(volBins)
            vv = map.get(volBins, kk)
            if vv > bestV
                bestV := vv
                bestK := kk
        prevPoc := (bestK + 0.5) * binW
    map.clear(volBins)
    binW := math.max(syminfo.mintick, math.round(open * 0.0002 / syminfo.mintick) * syminfo.mintick)
    if not na(rthH)
        prevRange := rthH - rthL            // completed prior session
        array.push(rngHist, prevRange)
        if array.size(rngHist) > 14
            array.shift(rngHist)
    rthH := high
    rthL := low
    open930 := open
else if inRTH
    rthH := math.max(rthH, high)
    rthL := math.min(rthL, low)
if inRTH and not na(binW)
    kb = int(math.floor(hlc3 / binW))
    map.put(volBins, kb, (map.contains(volBins, kb) ? map.get(volBins, kb) : 0.0) + volume)

up = open930 + k * prevRange
dn = open930 - k * prevRange
stopPts = stopMult * k * prevRange

// ---- signals at bar close
exitedNow = strategy.closedtrades > nz(strategy.closedtrades[1])     // research engine: re-entry only after the exit bar
canTrade = inRTH and modNow < 959 and not na(prevRange) and not na(open930) and tradesToday < maxTrades and not dayDone and strategy.position_size == 0 and not exitedNow and barstate.isconfirmed
atr14 = array.size(rngHist) == 14 ? array.avg(rngHist) : na
gapRaw = not na(pc) and not na(atr14) and atr14 > 0 ? (open930 - pc) / atr14 : na
smallGap(int d) =>
    gapFilt and not na(gapRaw) and gapRaw * d > gapLo and gapRaw * d <= gapHi
sigL0 = canTrade and high >= up
sigS0 = canTrade and side == "Both" and not sigL0 and low <= dn
sigL = sigL0 and not smallGap(1)
sigS = sigS0 and not smallGap(-1)
// as in the research engine: in long-only mode, a first touch of the SHORT trigger ends the day
if canTrade and side == "Long only" and not sigL and low <= dn
    dayDone := true

qtyFor() =>
    riskNow = riskMode == "Prop phase $" ? (propPhase == "Eval" ? riskEval : riskFund) : riskMode == "Fixed $" ? riskUsd : strategy.equity * riskPct / 100
    q = riskMode == "Fixed qty" ? fixedQty : riskNow / (stopPts * syminfo.pointvalue)
    math.max(math.floor(q / qtyStep) * qtyStep, qtyStep)

var float curStop = na
var float mfe = 0.0
var float R = na
var float tpDist = na
if sigL or sigS
    R := stopPts
    q = qtyFor()
    dSig = sigL ? 1 : -1
    tpDist := na
    if usePoc and not na(prevPoc)
        dist = (prevPoc - close) * dSig                    // close as proxy for the next-bar fill
        tpDist := dist >= pocMinR * R and dist <= pocMaxR * R ? dist : na
    if sigL
        strategy.entry("L", strategy.long, qty = q)
        strategy.exit("XL", "L", loss = cutR * R / syminfo.mintick, profit = na(tpDist) ? na : tpDist / syminfo.mintick, comment_loss = "SL/Trail", comment_profit = "POC")
    else
        strategy.entry("S", strategy.short, qty = q)
        strategy.exit("XS", "S", loss = cutR * R / syminfo.mintick, profit = na(tpDist) ? na : tpDist / syminfo.mintick, comment_loss = "SL/Trail", comment_profit = "POC")
    tradesToday += 1

pos = strategy.position_size
if pos != 0
    ep = strategy.position_avg_price
    if na(curStop)
        curStop := pos > 0 ? ep - cutR * R : ep + cutR * R
        mfe := 0.0
    mfe := math.max(mfe, pos > 0 ? high - ep : ep - low)
    if useTrail
        n = math.floor(mfe / R + 1e-9)
        if n >= 1
            ns = ep + (pos > 0 ? 1 : -1) * (n - lag) * R
            curStop := pos > 0 ? math.max(curStop, ns) : math.min(curStop, ns)
    tpPx = na(tpDist) ? na : ep + (pos > 0 ? 1 : -1) * tpDist
    if pos > 0
        strategy.exit("XL", "L", stop = curStop, limit = tpPx, comment_loss = "SL/Trail", comment_profit = "POC")
    else
        strategy.exit("XS", "S", stop = curStop, limit = tpPx, comment_loss = "SL/Trail", comment_profit = "POC")
    if modNow >= 959 or session.islastbar
        strategy.close_all(comment = "EOD", immediately = true)
else
    curStop := na

plot(inRTH ? up : na, "Long trigger", color.new(color.green, 0), 1, plot.style_linebr)
plot(inRTH and side == "Both" ? dn : na, "Short trigger", color.new(color.red, 0), 1, plot.style_linebr)
plot(strategy.position_size != 0 ? curStop : na, "Stop / trail", color.new(color.fuchsia, 0), 2, plot.style_linebr)
plot(usePoc and inRTH ? prevPoc : na, "Prior RTH POC", color.new(color.orange, 0), 1, plot.style_circles)
