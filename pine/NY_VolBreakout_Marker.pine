// NY Volatility Breakout - TRADE MARKER (indicator, places no orders)
//
// Marks every trade the VBO bot (pine/NY_VolBreakout_Bot.pine, research/V7-V10) would have taken:
// entry, stop / trailing stop, exit and result in R after costs, plus a statistics table.
// Same rules as the research engine (research/v10.py, run10 with cut = cutR):
//   * Prior RTH range PR (09:30-15:59 NY). Triggers: today's 09:30 open +/- k*PR.
//   * Signal at the close of a bar whose high >= UP (long) / low <= DN (short); fill at the next bar's open + slippage.
//   * Stop = cutR * R from the fill, R = stopMult * k * PR. R-step trailing: at +n R MFE -> stop = entry + (n - lag) R,
//     updated at bar close, active from the next bar. Exit at the close of the 15:59 bar. Max 2 trades/day,
//     a new signal is possible from the bar after an exit.
//   * Gap filter (live variant): trades on small-gap days are still simulated (they block the slot, as in the
//     research), but shown in grey and NOT counted ("gefiltert").
// Decisions only at bar close (barstate.isconfirmed), no lookahead. 1-minute chart, MNQ/NQ or NAS100 CFD.
//@version=6
indicator("NY VBO Trade-Marker", shorttitle = "VBO-Marker", overlay = true, max_labels_count = 500, max_lines_count = 500)

TZ = "America/New_York"
grpS = "Signal (wie im Bot)"
k        = input.float(0.35, "k (Abstand = k x Vortagesspanne)", step = 0.05, group = grpS)
stopMult = input.float(0.75, "Stop = x * (k x Vortagesspanne)", step = 0.05, group = grpS)
side     = input.string("Both", "Richtung", options = ["Long only", "Both"], group = grpS)
maxTrades = input.int(2, "Max. Trades pro Tag", minval = 1, maxval = 3, group = grpS)
useTrail = input.bool(true, "R-Trailing", group = grpS)
lag      = input.float(1.25, "Trailing-Abstand (R)", step = 0.25, group = grpS)
cutR     = input.float(1.0, "Anfangsstop bei x * R", step = 0.05, minval = 0.5, maxval = 1.0, group = grpS)
gapFilt  = input.bool(true, "Gap-Filter (Live-Variante)", group = grpS)
gapLo    = input.float(-0.405, "Gap-Filter: auslassen wenn Gap/ATR14 in Richtung >", step = 0.01, group = grpS)
gapHi    = input.float(0.079, "... und <=", step = 0.01, group = grpS)
grpC = "Kosten & Anzeige"
market   = input.string("MNQ/NQ Future", "Kosten", options = ["MNQ/NQ Future", "NAS100 CFD"], group = grpC, tooltip = "Future: 0,75 Pkt. Kommission pro Trade. CFD: 1,2 Pkt. Spread pro Trade.")
slip     = input.float(0.25, "Slippage pro Market-Fill (Punkte)", step = 0.05, group = grpC)
riskUsd  = input.float(100, "Risiko pro Trade in $ (nur für die $-Anzeige)", group = grpC)
startT   = input.time(timestamp("UTC", 2026, 10, 6, 0, 0), "Forward-Test ab", group = grpC)
showFilt = input.bool(true, "Gefilterte Trades grau anzeigen", group = grpC)
showTbl  = input.bool(true, "Statistik-Tabelle", group = grpC)
cost = market == "MNQ/NQ Future" ? 0.75 : 1.2

modNow = hour(time, TZ) * 60 + minute(time, TZ)
inRTH  = modNow >= 570 and modNow < 960
rthStart = inRTH and (not inRTH[1] or time - time[1] > 6 * 3600000)

// ---- session bookkeeping: prior RTH range, 09:30 open, prior RTH close, ATR14 of RTH ranges
var float rthH = na
var float rthL = na
var float prevRange = na
var float open930 = na
var float lastRthClose = na
var float pc = na
var array<float> rngHist = array.new_float(0)
var int tradesToday = 0
var bool dayDone = false
var int todayN = 0
var float todayR = 0.0
if rthStart
    pc := lastRthClose
    if not na(rthH)
        prevRange := rthH - rthL
        array.push(rngHist, prevRange)
        if array.size(rngHist) > 14
            array.shift(rngHist)
    rthH := high
    rthL := low
    open930 := open
    tradesToday := 0
    dayDone := false
    todayN := 0
    todayR := 0.0
else if inRTH
    rthH := math.max(rthH, high)
    rthL := math.min(rthL, low)
if inRTH
    lastRthClose := close

up = open930 + k * prevRange
dn = open930 - k * prevRange
atr14 = array.size(rngHist) == 14 ? array.avg(rngHist) : na
gapRaw = not na(pc) and not na(atr14) and atr14 > 0 and not na(open930) ? (open930 - pc) / atr14 : na

// ---- trade engine (bar close only)
var int pos = 0
var bool filt = false
var int pendDir = 0
var bool pendFilt = false
var float pendR = na
var float ep = na
var float R = na
var float st = na
var float mfe = 0.0
var int entryBar = na
var int tradeNo = 0
var array<float> rArr = array.new_float(0)
var array<int> tArr = array.new_int(0)

fmtR(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.00") + "R"

if barstate.isconfirmed
    bool exitedNow = false
    // 1) pending signal -> fill at this bar's open
    if pendDir != 0
        pos := pendDir
        filt := pendFilt
        ep := open + pos * slip
        R := pendR
        st := ep - pos * cutR * R
        mfe := 0.0
        entryBar := bar_index
        pendDir := 0
        tradeNo += 1
        col = filt ? color.new(color.gray, 30) : pos == 1 ? color.new(color.green, 0) : color.new(color.red, 0)
        if not filt or showFilt
            label.new(bar_index, pos == 1 ? low : high, (pos == 1 ? "L" : "S") + str.tostring(tradesToday) + (filt ? " gefiltert" : ""),
                 style = pos == 1 ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small,
                 tooltip = "Einstieg ~" + str.tostring(ep, format.mintick) + "\nStop " + str.tostring(st, format.mintick) +
                 "\nR = " + str.tostring(R, "0.00") + " Pkt." + (filt ? "\nGap-Filter: wird nicht gehandelt" : ""))
    // 2) manage the open position
    if pos != 0
        mfe := math.max(mfe, pos == 1 ? high - ep : ep - low)
        float x = na
        string why = ""
        bool hit = pos == 1 ? low <= st : high >= st
        if hit
            bool gapThru = pos == 1 ? open <= st : open >= st
            x := (gapThru ? open : st) - pos * slip
            why := (pos == 1 ? st > ep - cutR * R : st < ep + cutR * R) ? "Trail-Stop" : "Stop"
        else if modNow >= 959 or not inRTH
            x := (inRTH ? close : open) - pos * slip
            why := "Tagesende"
        else if useTrail
            int n = math.floor(mfe / R + 1e-9)
            if n >= 1
                float ns = ep + pos * (n - lag) * R
                float old = st
                st := pos == 1 ? math.max(st, ns) : math.min(st, ns)
                if st != old and not filt
                    alert("VBO: Stop nachziehen auf " + str.tostring(st, format.mintick) + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
        if not na(x)
            float pts = (x - ep) * pos
            float rr = (pts - cost) / (cutR * R)
            if not filt
                array.push(rArr, rr)
                array.push(tArr, time)
                todayN += 1
                todayR += rr
            col = filt ? color.new(color.gray, 30) : rr > 0 ? color.new(color.green, 0) : color.new(color.red, 0)
            if not filt or showFilt
                label.new(bar_index, pos == 1 ? high : low, (filt ? "(" : "") + fmtR(rr) + (filt ? ")" : ""),
                     style = pos == 1 ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.small,
                     tooltip = why + "\nAusstieg ~" + str.tostring(x, format.mintick) + "\n" + str.tostring(pts, "0.00") + " Pkt. vor Kosten" +
                     "\n$ " + str.tostring(rr * riskUsd, "0") + " bei " + str.tostring(riskUsd, "0") + " $ Risiko")
                line.new(entryBar, ep, bar_index, x, color = col, style = line.style_dotted, width = 1)
            if not filt and why == "Tagesende"
                alert("VBO: Position zum Tagesende schließen (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
            pos := 0
            exitedNow := true
    // 3) new signal (decided at this bar's close, filled at the next bar's open)
    bool canSig = inRTH and modNow < 959 and pos == 0 and pendDir == 0 and not exitedNow and not na(prevRange) and not na(open930) and tradesToday < maxTrades and not dayDone
    if canSig
        int d = high >= up ? 1 : low <= dn ? -1 : 0
        if d == -1 and side == "Long only"
            dayDone := true
            d := 0
        if d != 0
            pendDir := d
            pendFilt := gapFilt and not na(gapRaw) and gapRaw * d > gapLo and gapRaw * d <= gapHi
            pendR := stopMult * k * prevRange
            tradesToday += 1
            if not pendFilt
                alert("VBO: " + (d == 1 ? "LONG" : "SHORT") + "-Signal (" + syminfo.ticker + "). Market-Order jetzt, Stop " +
                     str.tostring(cutR * pendR, "0.00") + " Pkt. vom Einstieg (" + (d == 1 ? "darunter" : "darüber") + ")", alert.freq_once_per_bar_close)

// ---- plots
plot(inRTH ? up : na, "Long-Trigger", color.new(color.green, 0), 1, plot.style_linebr)
plot(inRTH and side == "Both" ? dn : na, "Short-Trigger", color.new(color.red, 0), 1, plot.style_linebr)
plot(pos != 0 ? st : na, "Stop / Trail", filt ? color.new(color.gray, 40) : color.new(color.fuchsia, 0), 2, plot.style_linebr)

// ---- statistics
stats(int t0) =>
    int n = 0
    int w = 0
    float s = 0.0
    float peak = 0.0
    float mdd = 0.0
    int cur = 0
    int mx = 0
    int sz = array.size(rArr)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(tArr, i) >= t0
                float r = array.get(rArr, i)
                n += 1
                s += r
                if r > 0
                    w += 1
                    cur := 0
                else
                    cur += 1
                    mx := math.max(mx, cur)
                peak := math.max(peak, s)
                mdd := math.max(mdd, peak - s)
    [n, w, s, mdd, mx]

var table tb = table.new(position.top_right, 3, 9, bgcolor = color.new(color.black, 20), border_width = 1)
cell(int c, int r, string t, color tc = color.white) =>
    table.cell(tb, c, r, t, text_color = tc, text_size = size.small)
if showTbl and barstate.islast
    [n1, w1, s1, d1, m1] = stats(0)
    [n2, w2, s2, d2, m2] = stats(startT)
    cell(0, 0, "VBO-Marker")
    cell(1, 0, "Chart gesamt")
    cell(2, 0, "seit " + str.format_time(startT, "dd.MM.yyyy", TZ))
    cell(0, 1, "Trades")
    cell(1, 1, str.tostring(n1))
    cell(2, 1, str.tostring(n2))
    cell(0, 2, "Trefferquote")
    cell(1, 2, n1 > 0 ? str.tostring(100.0 * w1 / n1, "0.0") + " %" : "-")
    cell(2, 2, n2 > 0 ? str.tostring(100.0 * w2 / n2, "0.0") + " %" : "-")
    cell(0, 3, "Ø R / Trade")
    cell(1, 3, n1 > 0 ? fmtR(s1 / n1) : "-")
    cell(2, 3, n2 > 0 ? fmtR(s2 / n2) : "-")
    cell(0, 4, "Summe R")
    cell(1, 4, fmtR(s1), s1 >= 0 ? color.lime : color.red)
    cell(2, 4, fmtR(s2), s2 >= 0 ? color.lime : color.red)
    cell(0, 5, "Summe $")
    cell(1, 5, str.tostring(s1 * riskUsd, "0"))
    cell(2, 5, str.tostring(s2 * riskUsd, "0"))
    cell(0, 6, "Max. Drawdown")
    cell(1, 6, str.tostring(d1, "0.0") + "R")
    cell(2, 6, str.tostring(d2, "0.0") + "R")
    cell(0, 7, "Längste Verlustserie")
    cell(1, 7, str.tostring(m1))
    cell(2, 7, str.tostring(m2))
    cell(0, 8, "Heute")
    cell(1, 8, str.tostring(todayN) + " Trades")
    cell(2, 8, fmtR(todayR), todayR >= 0 ? color.lime : color.red)
